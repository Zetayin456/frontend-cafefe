# Secretos y configuracion local (conserva plantillas de ejemplo)
.env
.env.*
!.env.example
!.env.*.example
.npmrc
!.npmrc.example
*.pem
*.key
*.p12
*.pfx

# Dependencias y salidas generadas
node_modules/
coverage/
dist/
build/
.cache/

