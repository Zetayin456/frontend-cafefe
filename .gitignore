.vscode/*
!.vscode/tasks.json
.idea/
.history/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Guia local de ejecucion (no forma parte del entregable del frontend)
/GUIA_EJECUCION_FRONTEND.pdf
